{
  "compaction": {
    "modelOverrides": {
      "<lead-provider>/<lead-model>": {
        "reserveTokens": 600000
      }
    }
  },
  "retry": {
    "modelFallback": true,
    "fallbackChains": {
      "<lead-provider>/<lead-model>": [
        "<second-subscription-provider>/<model>",
        "<low-cost-provider>/<fast-model>",
        "<api-key-provider>/<lead-model>",
        "<other-provider>/<model>"
      ]
    }
  }
}
